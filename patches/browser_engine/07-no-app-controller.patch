# browser_engine touch point: inside the app, no AppController and no main menu
# (CEF's guard in chrome_runtime.patch): the app is NSApp's delegate and owns
# the menu. The hooks do AppController's part: its keep-alive (so the browser
# lives with no windows), dropping it on NSApplicationWillTerminateNotification,
# and the TabRestoreService reset at the end of the main loop.
# DidEndMainMessageLoop() needs the guard too: AppController.sharedController
# creates the controller (and takes NSApp.delegate) on first use.

diff --git a/chrome/browser/chrome_browser_main_mac.mm b/chrome/browser/chrome_browser_main_mac.mm
--- a/chrome/browser/chrome_browser_main_mac.mm
+++ b/chrome/browser/chrome_browser_main_mac.mm
@@ -20,6 +20,7 @@
 #include "base/metrics/histogram_functions.h"
 #include "base/path_service.h"
 #include "base/strings/sys_string_conversions.h"
+#include "browser_engine/browser_engine_hooks.h"  // nogncheck
 #include "build/branding_buildflags.h"
 #import "chrome/browser/app_controller_mac.h"
 #include "chrome/browser/apps/app_shim/app_shim_listener.h"
@@ -154,6 +155,12 @@ int ChromeBrowserMainPartsMac::PreCreateThreads() {
     return ret;
   }
 
+  // browser_engine: the app is NSApp's delegate and owns the main menu.
+  if (browser_engine::IsEmbedded()) {
+    browser_engine::GetHooks()->PreCreateThreads();
+    return content::RESULT_CODE_NORMAL_EXIT;
+  }
+
   // Create the app delegate by requesting the shared AppController.
   CHECK_EQ(nil, NSApp.delegate);
   AppController* app_controller = AppController.sharedController;
@@ -182,5 +189,10 @@ void ChromeBrowserMainPartsMac::PostProfileInit(Profile* profile,
 }
 
 void ChromeBrowserMainPartsMac::DidEndMainMessageLoop() {
+  // browser_engine: AppController.sharedController would make one now.
+  if (browser_engine::IsEmbedded()) {
+    browser_engine::GetHooks()->DidEndMainMessageLoop();
+    return;
+  }
   [AppController.sharedController didEndMainMessageLoop];
 }
