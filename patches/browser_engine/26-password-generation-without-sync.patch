# browser_engine touch point: inside the app, Chrome suggests a strong password
# for a new password field (and from the right-click menu), as Safari does for
# everyone and Chrome for those whose passwords sync to their Google account.
# ungoogled-chromium has no sync, so Chrome never offered it. Its prompt said
# the password goes to the account's Google Password Manager "for <email>",
# with no account to name: it says "on this device", where it's kept. (The
# code still passes the email; unused, as no build here checks placeholders.)

diff --git a/components/password_manager/core/browser/password_feature_manager_impl.cc b/components/password_manager/core/browser/password_feature_manager_impl.cc
--- a/components/password_manager/core/browser/password_feature_manager_impl.cc
+++ b/components/password_manager/core/browser/password_feature_manager_impl.cc
@@ -5,6 +5,7 @@
 #include "components/password_manager/core/browser/password_feature_manager_impl.h"
 
 #include "base/feature_list.h"
+#include "browser_engine/browser_engine_hooks.h"  // nogncheck
 #include "build/build_config.h"
 #include "components/password_manager/core/browser/features/password_features.h"
 #include "components/password_manager/core/browser/features/password_manager_features_util.h"
@@ -26,6 +27,11 @@
       sync_service_(sync_service) {}
 
 bool PasswordFeatureManagerImpl::IsGenerationEnabled() const {
+  // browser_engine: inside the app, strong passwords are suggested without
+  // sync too; they're saved in the profile's own store, as any other.
+  if (browser_engine::IsEmbedded()) {
+    return true;
+  }
   switch (password_manager::sync_util::GetPasswordSyncState(sync_service_)) {
     case sync_util::SyncState::kNotActive:
       return false;
