# browser_engine touch point: Chrome's address save and update bubbles in our windows.
# AddressBubblesController finds its window's AutofillBubbleHandler with
# BrowserWindow::FindBrowserWindowWithWebContents(), which at 156 finds BrowserViews only;
# for our windows the tab's own BrowserWindow is the one (its handler is Chrome's
# AutofillBubbleHandlerImpl). Saving then offers Chrome on iOS through AsBrowserView(),
# unchecked: not inside the app.

diff --git a/chrome/browser/ui/autofill/address_bubbles_controller.cc b/chrome/browser/ui/autofill/address_bubbles_controller.cc
--- a/chrome/browser/ui/autofill/address_bubbles_controller.cc
+++ b/chrome/browser/ui/autofill/address_bubbles_controller.cc
@@ -14,6 +14,7 @@
 #include "base/strings/string_util.h"
