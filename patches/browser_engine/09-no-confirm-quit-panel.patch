# browser_engine touch point: chrome::AttemptUserExit() (IDC_EXIT) asks
# AppController.sharedController for the confirm-to-quit panel, which would
# create an AppController and take over NSApp's delegate. Inside the app it goes
# straight to [NSApp terminate:], which the app routes to -[BEEngine quit].

diff --git a/chrome/browser/browser_process_platform_part_mac.mm b/chrome/browser/browser_process_platform_part_mac.mm
--- a/chrome/browser/browser_process_platform_part_mac.mm
+++ b/chrome/browser/browser_process_platform_part_mac.mm
@@ -6,6 +6,7 @@
 
 #include "base/apple/foundation_util.h"
 #include "base/time/time.h"
+#include "browser_engine/browser_engine_hooks.h"  // nogncheck
 #import "chrome/browser/app_controller_mac.h"
 #include "chrome/browser/apps/app_shim/app_shim_manager_mac.h"
 #include "chrome/browser/apps/app_shim/web_app_shim_manager_delegate_mac.h"
@@ -35,7 +36,11 @@ void BrowserProcessPlatformPart::AttemptExit(bool try_to_quit_application) {
   // |try_to_quit_application| set to true; keyboard menu invocations have it
   // set to false.
 
-  if (!try_to_quit_application) {
+  // browser_engine: no AppController (nor its confirm-to-quit panel) inside
+  // our app; asking for AppController.sharedController would make one and
+  // take over NSApp's delegate. Terminate() below reaches the app, which
+  // routes -terminate: to -[BEEngine quit].
+  if (!try_to_quit_application && !browser_engine::IsEmbedded()) {
     // A keyboard menu invocation.
     if ([AppController.sharedController confirmQuitIfNeeded] ==
         ConfirmQuitResultAborted) {
