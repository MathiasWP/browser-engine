+++ b/components/sessions/content/content_live_tab.cc
@@ -7,6 +7,7 @@
 #include <memory>
 
 #include "base/memory/ptr_util.h"
+#include "browser_engine/browser_engine_hooks.h"  // nogncheck
 #include "components/sessions/content/content_platform_specific_tab_data.h"
 #include "components/sessions/content/session_tab_helper.h"
 #include "content/public/browser/navigation_controller.h"
@@ -28,6 +29,14 @@
 }
 
 bool ContentLiveTab::IsInitialBlankNavigation() {
+  // browser_engine: an agent's tab goes into recently closed as one that never
+  // loaded a page, which is left out (TabRestoreServiceHelper::PopulateTab()),
+  // whether it closes alone or with its window or group: reopened, its pages
+  // would be in the profile's own storage.
+  if (browser_engine::IsEmbedded() &&
+      browser_engine::GetHooks()->IsAgentTab(&GetWebContents())) {
+    return true;
+  }
   return navigation_controller().IsInitialBlankNavigation();
 }
 
