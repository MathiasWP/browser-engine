# browser_engine touch point: agents' tabs (BEWindowAgentTabs, be_agent_tabs.mm)
# are kept out of the profile's own records, which would mix them with the
# user's or bring them back in the profile's own storage
# (Hooks::IsAgentTab(), a tab whose page keeps to an agent's partition):
# - history_tab_helper.cc: no visits, titles or end times in the profile's
#   history, as for a private window, so nothing in the address bar's history
#   suggestions or the most visited sites.
# - session_tab_helper_factory.cc, session_service_base.cc: not saved with the
#   session, as it changes (the tab's SessionTabHelper has no delegate) or when
#   rebuilt (BuildCommandsForTab()). A saved tab without navigations isn't
#   restored. (Saving the partition and restoring into it would need it in
#   SessionService's and TabRestoreService's formats; agents come back through
#   the app instead.)
# - content_live_tab.cc: not in recently closed (⇧⌘T), alone or with its
#   window or group: TabRestoreServiceHelper::PopulateTab() leaves out a tab
#   that never loaded a page.
# - tab_lifecycle_unit.cc: never discarded. Memory Saver leaves it already
#   (the layer makes it not auto-discardable), but chrome.tabs.discard()
#   doesn't, and the WebContents that replaces a discarded tab is in the
#   profile's own storage.

diff --git a/chrome/browser/history/history_tab_helper.cc b/chrome/browser/history/history_tab_helper.cc
--- a/chrome/browser/history/history_tab_helper.cc
+++ b/chrome/browser/history/history_tab_helper.cc
@@ -8,6 +8,7 @@
 #include <string>
 
 #include "base/metrics/histogram_macros.h"
+#include "browser_engine/browser_engine_hooks.h"  // nogncheck
 #include "build/build_config.h"
 #include "chrome/browser/actor/actor_keyed_service.h"
 #include "chrome/browser/actor/actor_task.h"
@@ -647,6 +648,13 @@
   Profile* profile =
       Profile::FromBrowserContext(web_contents()->GetBrowserContext());
   if (profile->IsOffTheRecord()) {
+    return nullptr;
+  }
+  // browser_engine: an agent's tab adds nothing to the profile's history (so
+  // nothing to its address bar's suggestions or most visited sites either),
+  // as a private window's doesn't (be_agent_tabs.mm).
+  if (browser_engine::IsEmbedded() &&
+      browser_engine::GetHooks()->IsAgentTab(web_contents())) {
     return nullptr;
   }
 
