# browser_engine touch point: an HTTP authentication challenge (a site's or a
# proxy's) shows Chrome's sign-in dialog, made by LoginHandler::Create(). Inside
# the app, the layer asks first: for a tab whose app draws page dialogs it
# returns its own LoginHandler (be_page_dialogs.mm), which shows the app's
# sign-in, fills in what the password manager saved, and answers with
# SetAuth() and CancelAuth() as the Views dialog does.

diff --git a/chrome/browser/ui/views/login_handler_views.cc b/chrome/browser/ui/views/login_handler_views.cc
--- a/chrome/browser/ui/views/login_handler_views.cc
+++ b/chrome/browser/ui/views/login_handler_views.cc
@@ -6,6 +6,7 @@
 
 #include "base/memory/raw_ptr.h"
 #include "base/strings/utf_string_conversions.h"
+#include "browser_engine/browser_engine_hooks.h"  // nogncheck
 #include "chrome/browser/ui/blocked_content/popunder_preventer.h"
 #include "chrome/browser/ui/dialogs/browser_dialogs.h"
 #include "chrome/browser/ui/login/login_handler.h"
@@ -231,6 +232,15 @@
     const net::AuthChallengeInfo& auth_info,
     content::WebContents* web_contents,
     content::LoginDelegate::LoginAuthRequiredCallback auth_required_callback) {
+  // browser_engine: inside the app, the app draws the sign-in for its tabs
+  // (be_page_dialogs.mm), on the same LoginHandler.
+  if (browser_engine::IsEmbedded()) {
+    if (std::unique_ptr<LoginHandler> handler =
+            browser_engine::GetHooks()->CreateLoginHandler(
+                auth_info, web_contents, auth_required_callback)) {
+      return handler;
+    }
+  }
   return std::make_unique<LoginHandlerViews>(auth_info, web_contents,
                                              std::move(auth_required_callback));
 }
