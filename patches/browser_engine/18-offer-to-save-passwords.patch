# browser_engine touch point: inside the app, Chrome offers to save passwords
# by default, as Chrome and Safari do. ungoogled-chromium's
# inox-patchset/0006-modify-default-prefs.patch turns credentials_enable_service
# off; the "Offer to save passwords" setting is unchanged.

diff --git a/components/password_manager/core/browser/password_manager.cc b/components/password_manager/core/browser/password_manager.cc
--- a/components/password_manager/core/browser/password_manager.cc
+++ b/components/password_manager/core/browser/password_manager.cc
@@ -24,6 +24,7 @@
 #include "base/threading/platform_thread.h"
 #include "base/time/time.h"
 #include "base/types/optional_util.h"
+#include "browser_engine/browser_engine_hooks.h"  // nogncheck
 #include "build/build_config.h"
 #include "components/affiliations/core/browser/affiliation_utils.h"
 #include "components/autofill/core/browser/autofill_field.h"
@@ -548,8 +549,10 @@ PasswordForm CreateFormForLeakCheck(const PasswordForm& pending_credentials,
 // static
 void PasswordManager::RegisterProfilePrefs(
     user_prefs::PrefRegistrySyncable* registry) {
+  // browser_engine: inside the app, Chrome offers to save passwords, as Chrome
+  // and Safari do (ungoogled-chromium's inox defaults turn it off).
   registry->RegisterBooleanPref(
-      prefs::kCredentialsEnableService, false,
+      prefs::kCredentialsEnableService, browser_engine::IsEmbedded(),
       user_prefs::PrefRegistrySyncable::SYNCABLE_PRIORITY_PREF);
   registry->RegisterBooleanPref(
       prefs::kCredentialsEnableAutosignin, false,
